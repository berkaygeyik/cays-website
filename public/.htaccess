# Apache config for serving the built site (dist/) from the web root.
# Needs mod_rewrite and "AllowOverride FileInfo" (or All) for this directory.
# Vite copies this file from public/ into dist/ automatically.

# Single-page app: send every non-file route (/menu, /contact, ...) to index.html
# so React Router can render it. Missing files under /assets and /images are
# left alone so they return a real 404 instead of the HTML page.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(assets|images)/ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed build files never change, cache them for a year.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Always revalidate the HTML shell so new deploys show up right away.
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
